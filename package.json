{
  "name": "forge-tenant-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "node tests/e2e.cjs",
    "test:tasks": "node tests/coding-integration.cjs",
    "open": "node scripts/open-console.cjs",
    "format": "prettier --write src tests scripts/*.cjs *.ts *.json index.html",
    "format:check": "prettier --check src tests scripts/*.cjs *.ts *.json index.html",
    "test:prototype": "node tests/prototype-e2e.cjs",
    "export:prototype": "npm run build && node scripts/export-prototype.cjs",
    "test:sso": "node tests/sso.cjs",
    "test:diff": "node tests/code-diff.cjs",
    "test:trace": "node tests/run-trace.cjs",
    "test:task-diff": "node tests/task-diff.cjs"
  },
  "dependencies": {
    "diff2html": "3.4.56",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.9",
    "playwright": "1.58.2",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "8.3.2",
    "vue-tsc": "3.3.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
